# Runtime
APP_ENV=development
APP_NAME=Autonomous Assistant
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Database (replace secrets outside disposable local development)
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://assistant:change-me@postgres:5432/assistant

# Queue and scheduler
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Authentication and encryption; generate unique high-entropy values
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-valid-key
ACCESS_TOKEN_TTL_MINUTES=30

# AI provider abstraction. `mock` requires no external API key.
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_API_KEY=
EMBEDDING_MODEL=mock-embedding-v1

# Safety and cost controls
DEFAULT_DAILY_BUDGET_USD=5.00
DEFAULT_MONTHLY_BUDGET_USD=100.00
MAX_AGENT_ITERATIONS=30
MAX_TOOL_CALLS_PER_RUN=50
MAX_TASK_DURATION_SECONDS=7200
DEFAULT_TIMEZONE=UTC
DEFAULT_BRIEFING_TIME=07:00

# Backend-only web research adapter
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=

# Frontend: only NEXT_PUBLIC_* values are browser-visible
NEXT_PUBLIC_API_URL=http://localhost:8000
